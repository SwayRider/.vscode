# Tiles Service
export SWAYRIDER_DEBUG_TILESSERVICE_HOST="${SWAYRIDER_TILESSERVICE_HOST}"
export SWAYRIDER_DEBUG_TILESSERVICE_HTTP_PORT="${SWAYRIDER_TILESSERVICE_HTTP_PORT}"
