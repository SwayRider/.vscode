# Router Service
export SWAYRIDER_DEBUG_ROUTERSERVICE_HOST="${SWAYRIDER_ROUTERSERVICE_HOST}"
export SWAYRIDER_DEBUG_ROUTERSERVICE_HTTP_PORT="${SWAYRIDER_ROUTERSERVICE_HTTP_PORT}"
