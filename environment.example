#export SWAYRIDER_DEBUG_ROUTERSERVICE_GRPC_PORT="${SWAYRIDER_LOCAL_ROUTERSERVICE_GRPC_PORT}"

# Search Service
export SWAYRIDER_DEBUG_SEARCHSERVICE_HOST="${SWAYRIDER_SEARCHSERVICE_HOST}"
export SWAYRIDER_DEBUG_SEARCHSERVICE_HTTP_PORT="${SWAYRIDER_SEARCHSERVICE_HTTP_PORT}"
