export SWAYRIDER_DEBUG_MAILSERVICE_HOST="${SWAYRIDER_MAILSERVICE_HOST}"
export SWAYRIDER_DEBUG_MAILSERVICE_HTTP_PORT="${SWAYRIDER_MAILSERVICE_HTTP_PORT}"
export SWAYRIDER_DEBUG_MAILSERVICE_GRPC_PORT="${SWAYRIDER_MAILSERVICE_GRPC_PORT}"
