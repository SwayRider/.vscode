export SWAYRIDER_DEBUG_REGIONSERVICE_HOST="${SWAYRIDER_REGIONSERVICE_HOST}"
export SWAYRIDER_DEBUG_REGIONSERVICE_HTTP_PORT="${SWAYRIDER_REGIONSERVICE_HTTP_PORT}"
export SWAYRIDER_DEBUG_REGIONSERVICE_GRPC_PORT="${SWAYRIDER_REGIONSERVICE_GRPC_PORT}"
